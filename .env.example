# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริง (.env ต้องไม่ถูก commit เข้า git)

# KKUIntelSphere Gen AI Gateway
KKU_BASE_URL=https://gen.ai.kku.ac.th/api/v1
API_KEY=
# ชื่อโมเดลที่จะเรียกใช้ — gemini-3.5-flash-lite ทดสอบแล้ว (2026-10-11) ว่าใช้ได้กับทั้ง intent และ RAG ภาษาไทย
# (gpt-5-nano เดิมไม่อยู่ในรายชื่อโมเดลแล้ว)
# โมเดลอื่นดูได้จาก GET {KKU_BASE_URL}/models (รัน node server/scripts/list-models.js) — บางตัว เช่น
# กลุ่ม gemini อาจไม่มี endpoint ให้บริการ หรือไม่ยึด response_format:json_object เป๊ะ ๆ
KKU_MODEL=gemini-3.5-flash-lite

# Backend server
PORT=3001
DB_PATH=./server/data/course-planner.db
